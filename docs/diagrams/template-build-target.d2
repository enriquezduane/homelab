vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 8
    sketch: true
    center: true
    pad: 20
  }
}

direction: right

title: "Template Build: Target" {
  shape: text
  near: top-center
}

mac: "Mac (Packer)\nplugin pinned to exact version"
iso: "Debian 13 ISO\nchecksum verified"

install: "Temp VM on pve\nunattended install\nsingle root partition"
cleanup: "Cleanup\nkeys + machine-id wiped\nnetwork reset, disk trimmed"
template: "Template 9000\ndelete-protected"
smoke: "Smoke-test clone\nboot, SSH, IP, disk\nauto-destroyed"

clone: "Cloned VM\ncloud-init owns network\ndisk grows on resize"

mac -> install: "serves\npreseed"
iso -> install: "boot\nmedia"
install -> cleanup
cleanup -> template: freeze
template -> smoke: verify
smoke -> clone: "then\ntofu apply"
