vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 8
    sketch: true
    center: true
    pad: 20
  }
}

direction: right

title: "Template Build: Current" {
  shape: text
  near: top-center
}

mac: "Mac (Packer)\nplugin: any version >= 1.2.4"
iso: "Debian 13 ISO\nchecksum: not verified"

install: "Temp VM on pve\nunattended install\nroot + swap partitions"
cleanup: "Cleanup\nkeys + machine-id wiped\nnetwork reset"
template: "Template 9000\nunprotected\nnever test-booted"

clone: "Cloned VM\ndisk cannot grow"

mac -> install: "serves\npreseed"
iso -> install: "boot\nmedia"
install -> cleanup
cleanup -> template: freeze
template -> clone: "tofu apply"
